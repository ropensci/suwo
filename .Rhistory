skip_on_cran()
skip_if_offline()
skip_if_not(
requireNamespace("websocket", quietly = TRUE) &&
requireNamespace("later", quietly = TRUE),
"websocket and/or later not installed"
)
skip_if_not(.has_chrome_like_binary(), "No Chrome/Chromium binary found")
# a real or virtual display is required to launch a non-headless browser;
# this is typically only missing on bare Linux CI runners without Xvfb
skip_if(
Sys.info()[["sysname"]] == "Linux" && !nzchar(Sys.getenv("DISPLAY")),
"No DISPLAY available (headless Linux environment)"
)
}
.restore_wikiaves_cookies_env <- function() {
original_env <- Sys.getenv("wikiaves_cookies", unset = NA)
if (is.na(original_env)) {
Sys.unsetenv("wikiaves_cookies")
} else {
Sys.setenv(wikiaves_cookies = original_env)
}
}
test_that("access_wikiaves launch/CDP mechanics work (no cookies expected)", {
.skip_if_no_browser_env()
err <- tryCatch(
{
access_wikiaves(
url = "https://example.com",
challenge_wait = 5,
launch_wait = 8,
set_env = FALSE
)
NULL
},
error = function(e) conditionMessage(e)
)
# a launch/connection failure would produce a different message
# (e.g. "did not become reachable", "Could not open or find a tab", a
# websocket error); reaching the "required cookies ... not found" error
# instead confirms the browser launched, DevTools connected, a tab was
# opened at the target URL, and cookie polling ran to completion for
# this OS
expect_false(is.null(err))
expect_true(grepl("required cookies", err, ignore.case = TRUE))
})
test_that("access_wikiaves works when the browser is already running (reused instance)", {
.skip_if_no_browser_env()
# This is a regression test for a bug where, if a browser was already
# running on `port` (e.g. left over from an earlier call), the launch
# step -- and therefore navigation to `url` -- was skipped entirely,
# leaving access_wikiaves() waiting forever for a tab that could never
# appear. access_wikiaves() now explicitly opens (or reuses) a tab via
# the DevTools HTTP API regardless of whether the browser was just
# launched or was already running, so this should behave identically to
# a fresh launch rather than hanging or erroring differently.
# ensure a browser is already running on the default port before the
# "real" call under test happens, by making a throwaway call first
suppressMessages(try(
access_wikiaves(
url = "https://example.com",
challenge_wait = 5,
launch_wait = 8,
set_env = FALSE
),
silent = TRUE
))
# a fresh, unique URL guarantees no existing tab matches, forcing the
# explicit tab-creation fallback path while the browser is reused rather
# than freshly launched
unique_url <- paste0("https://example.com/?probe=", as.integer(Sys.time()))
start_time <- Sys.time()
err <- tryCatch(
{
access_wikiaves(
url = unique_url,
challenge_wait = 5,
launch_wait = 8,
set_env = FALSE
)
NULL
},
error = function(e) conditionMessage(e)
)
elapsed <- as.numeric(Sys.time() - start_time, units = "secs")
# should reach the same "required cookies" outcome as a fresh launch,
# and within a bounded time -- NOT hang or time out on tab-finding
expect_false(is.null(err))
expect_true(grepl("required cookies", err, ignore.case = TRUE))
expect_lt(elapsed, 8 + 5 + 10) # launch_wait + challenge_wait + slack
})
test_that("access_wikiaves retrieves and stores real cookies end-to-end", {
.skip_if_no_browser_env()
# save/restore the existing wikiaves_cookies value so this test does not
# leak a fake value into other tests (e.g. test_query_wikiaves.R)
on.exit(.restore_wikiaves_cookies_env(), add = TRUE)
mock_url <- paste0(
"https://httpbin.org/response-headers?",
"Set-Cookie=cf_clearance%3Dtest_cf_value",
"&Set-Cookie=PHPSESSID%3Dtest_session_value"
)
result <- try(
access_wikiaves(
url = mock_url,
challenge_wait = 10,
launch_wait = 8,
set_env = TRUE
),
silent = TRUE
)
skip_if(inherits(result, "try-error"), "Could not reach httpbin.org mock endpoint")
parsed <- jsonlite::fromJSON(result)
expect_equal(parsed[["cf_clearance"]], "test_cf_value")
expect_equal(parsed[["PHPSESSID"]], "test_session_value")
expect_true(nzchar(parsed[["browser_ua"]]))
# confirm the environment variable side effect actually happened
stored <- Sys.getenv("wikiaves_cookies")
expect_true(nzchar(stored))
stored_parsed <- jsonlite::fromJSON(stored)
expect_equal(stored_parsed[["cf_clearance"]], "test_cf_value")
expect_equal(stored_parsed[["PHPSESSID"]], "test_session_value")
})
test_that("access_wikiaves(set_env = FALSE) does not touch the environment variable", {
.skip_if_no_browser_env()
on.exit(.restore_wikiaves_cookies_env(), add = TRUE)
# start from a known, cleared state
Sys.unsetenv("wikiaves_cookies")
mock_url <- paste0(
"https://httpbin.org/response-headers?",
"Set-Cookie=cf_clearance%3Dtest_cf_value2",
"&Set-Cookie=PHPSESSID%3Dtest_session_value2"
)
result <- try(
access_wikiaves(
url = mock_url,
challenge_wait = 10,
launch_wait = 8,
set_env = FALSE
),
silent = TRUE
)
skip_if(inherits(result, "try-error"), "Could not reach httpbin.org mock endpoint")
# the function should still have returned the cookies string visibly...
expect_true(is.character(result))
parsed <- jsonlite::fromJSON(result)
expect_equal(parsed[["cf_clearance"]], "test_cf_value2")
# ...but must NOT have written it to the environment variable
expect_false(nzchar(Sys.getenv("wikiaves_cookies")))
})
# These tests exercise the *mechanics* of access_wikiaves() -- browser
# auto-detection/launch, tab creation via the DevTools HTTP API, the CDP
# websocket connection, cookie polling, JSON packing, and the
# wikiaves_cookies environment variable side effect -- without depending
# on WikiAves' live Cloudflare challenge, which can require a human to
# click through and therefore cannot be automated in CI.
#
# Instead of WikiAves, these tests point access_wikiaves() at plain,
# non-Cloudflare-protected URLs:
#   - https://example.com sets no cookies at all, so a call against it is
#     expected to time out with a specific "required cookies ... not found"
#     error -- reaching that error proves the browser launched, DevTools
#     connected, a tab was opened, and cookie polling ran correctly for
#     this OS.
#   - https://httpbin.org/response-headers lets us request arbitrary
#     Set-Cookie response headers via query parameters, so we can make it
#     set cookies literally named cf_clearance and PHPSESSID with known
#     values, with no JavaScript challenge and no redirect involved. This
#     lets us test the full success path (cookie retrieval, JSON packing,
#     and Sys.setenv()) end-to-end without ever touching WikiAves itself.
#
# Because neither target requires solving a Cloudflare challenge, these
# tests are expected to run unattended in CI across Linux, macOS, and
# Windows runners.
.has_chrome_like_binary <- function() {
nzchar(Sys.which("google-chrome")) ||
nzchar(Sys.which("google-chrome-stable")) ||
nzchar(Sys.which("chromium")) ||
nzchar(Sys.which("chromium-browser")) ||
(requireNamespace("chromote", quietly = TRUE) &&
!inherits(try(chromote::find_chrome(), silent = TRUE), "try-error"))
}
.skip_if_no_browser_env <- function() {
skip_on_cran()
skip_if_offline()
skip_if_not(
requireNamespace("websocket", quietly = TRUE) &&
requireNamespace("later", quietly = TRUE),
"websocket and/or later not installed"
)
skip_if_not(.has_chrome_like_binary(), "No Chrome/Chromium binary found")
# a real or virtual display is required to launch a non-headless browser;
# this is typically only missing on bare Linux CI runners without Xvfb
skip_if(
Sys.info()[["sysname"]] == "Linux" && !nzchar(Sys.getenv("DISPLAY")),
"No DISPLAY available (headless Linux environment)"
)
}
.restore_wikiaves_cookies_env <- function() {
original_env <- Sys.getenv("wikiaves_cookies", unset = NA)
if (is.na(original_env)) {
Sys.unsetenv("wikiaves_cookies")
} else {
Sys.setenv(wikiaves_cookies = original_env)
}
}
