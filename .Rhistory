# 4.4 Agregue un argumento lógico que permita a los usuarios (si lo desean) convertir los argumentos de entrada a su valor absoluto (usando la función abs()). Agregue las modificaciones necesarias para que la función haga los cálculos con y sin valores absolutos.
f4 <- function(x = 2, y = 1, w = 3, abso = TRUE){
z <- x * y * w
if (abso){
abso <- abs(z)
}
resultado <- log(z)
return(resultado)
}
f4(1, 2, 3)
f4(1, 2, -3)
# 4.4 Agregue un argumento lógico que permita a los usuarios (si lo desean) convertir los argumentos de entrada a su valor absoluto (usando la función abs()). Agregue las modificaciones necesarias para que la función haga los cálculos con y sin valores absolutos.
f4 <- function(x = 2, y = 1, w = 3, abso = TRUE){
z <- x * y * w
if (abso){
z <- abs(z)
}
resultado <- log(z)
return(resultado)
}
f4(1, 2, -3)
f4(1, 2, 3)
f4(1, 2, 0)
is.infinite(-Inf)
# 4.4 Agregue un argumento lógico que permita a los usuarios (si lo desean) convertir los argumentos de entrada a su valor absoluto (usando la función abs()). Agregue las modificaciones necesarias para que la función haga los cálculos con y sin valores absolutos.
f4 <- function(x = 2, y = 1, w = 3, abso = TRUE){
z <- x * y * w
if (abso){
z <- abs(z)
}
resultado <- log(z)
if(is.infinite(resultado))
resultado <- NA
return(resultado)
}
f4(1, 2, 3)
f4(1, 2, 0)
# 4.4 Agregue un argumento lógico que permita a los usuarios (si lo desean) convertir los argumentos de entrada a su valor absoluto (usando la función abs()). Agregue las modificaciones necesarias para que la función haga los cálculos con y sin valores absolutos.
f4 <- function(x = 2, y = 1, w = 3, abso = TRUE){
z <- x * y * w
if (abso){
z <- abs(z)
}
resultado <- log(z)
if(is.infinite(resultado))
resultado <- log(0.000000001)
return(resultado)
}
f4(1, 2, 3)
f4(1, 2, 0)
# 4.4 Agregue un argumento lógico que permita a los usuarios (si lo desean) convertir los argumentos de entrada a su valor absoluto (usando la función abs()). Agregue las modificaciones necesarias para que la función haga los cálculos con y sin valores absolutos.
f4 <- function(x = 2, y = 1, w = 3, abso = TRUE){
z <- x * y * w
if (abso){
z <- abs(z)
}
resultado <- log(z)
# if(is.infinite(resultado))
#   resultado <- log(0.000000001)
return(resultado)
}
f4(1, 2, 3)
f4(1, 2, 0)
all(c(TRUE, TRUE))
all(c(TRUE, FALSE))
all(c(FALSE, FALSE))
f4 <- function(x = 2, y = 1, w = 3, abso = TRUE, indef = FALSE){
z <- x * y * w
if (abso){
z <- abs(z)
}
resultado <- log(z)
if(all(is.infinite(resultado), !indef))
resultado <- log(0.000000001)
return(resultado)
}
f4(1, 2, 3)
f4(1, 2, 0)
f4(1, 2, 0, indef = TRUE)
