# Load suwo package
library(suwo)
h_sarapiquensis <- query_inaturalist(species = "Heliconia sarapiquensis",
format = "image")
head(h_sarapiquensis, 4)
# assuming access_wikiaves() was already run and its output stored as shown
# in the query_wikiaves() section below:
# Sys.setenv(wikiaves_cookies = access_wikiaves())
h_harpyja <- query_wikiaves(species = "Harpia harpyja", format = "sound",
cookies = Sys.getenv("wikiaves_cookies"))
# assuming access_wikiaves() was already run and its output stored as shown
# in the query_wikiaves() section below:
access_wikiaves()
h_harpyja <- query_wikiaves(species = "Harpia harpyja", format = "sound")
# Pre-compiled vignettes that depend on API key
# the original Rmd file is not included in the package,
# but is available in the GitHub repository at ./testing/suwo_vignette.Rmd
# modify and test ./testing/suwo_vignette.Rmd and then save it as
# vignettes/suwo.Rmd.orig
# save macaulay csvs in ./vignettes/
knitr::knit("vignettes/suwo.Rmd.orig", "vignettes/suwo.Rmd")
access_wikiaves()
devtools::document(".")
system("air format ./R --check")
system("air format .")
devtools::check(document = TRUE, run_dont_test = TRUE, vignettes = TRUE, manual = TRUE)
beepr::beep(3)
