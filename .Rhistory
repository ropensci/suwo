library(suwo)
# fansi turns real ANSI escape codes (the same ones cli emits in an
# interactive console) into styled HTML, so messages replayed below
# render with the same colors/formatting as a real RStudio console --
# NOT just plain black-and-white text. Only needed for rendering this
# vignette, not a runtime dependency of suwo itself.
library(fansi)
# force cli to emit real color/unicode output even though this is a
# non-interactive render, not an actual terminal session
options(cli.num_colors = 256, cli.unicode = TRUE)
knitr::opts_chunk$set(
fig.width = 6,
fig.height = 5,
message = FALSE,
warning = FALSE,
out.width = "100%",
out.heigth = "100%"
)
# knitr's `message` hook controls how condition-system message() output
# specifically is rendered (separate from normal printed/stdout output,
# which uses the `output` hook instead) -- .message() funnels through
# message(), so this is the correct hook to intercept
knitr::knit_hooks$set(message = function(x, options) {
paste0(
"<pre class=\"cli-message\"><code>",
fansi::sgr_to_html(paste(x, collapse = ""), warn = FALSE),
"</code></pre>"
)
})
# Xeno-Canto's API can be unreliable (intermittent server errors), so
# queries for this vignette are run ONCE here and their results cached to
# an RDS file. Every subsequent render loads from that file instead of
# hitting the live API -- see the "load queries" chunk below. To refresh
# the cache, run this chunk manually, then uncomment and run the
# saveRDS() line.
query_list <- list(
poospiza = query_xenocanto(species = "Poospiza hispaniolensis", pb = FALSE),
corcor = query_xenocanto(species = 'ann_sp:"Corvus corax"', pb = FALSE),
grycamp = query_xenocanto(
species = 'grp:grasshoppers ann_sp:"Gryllus campestris"',
pb = FALSE
),
all_bats = query_xenocanto(species = "ann:yes grp:bats", pb = FALSE),
all_frogs = query_xenocanto(species = "ann:yes grp:frogs", pb = FALSE)
)
# saveRDS(query_list, "./inst/articles/xenocanto_annotations_queries.rds")
all_frogs
